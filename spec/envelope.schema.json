{"$id":"https://example.invalid/agent-plaza/spec/envelope.schema.json","$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"description":"Normalized message envelope carried inside the hub. The body itself is referenced (bodyRef + bodySha256), not embedded. messageId and idempotencyKey are distinct values by design.","properties":{"bodyRef":{"minLength":1,"type":"string"},"bodySha256":{"pattern":"^[0-9a-f]{64}$","type":"string"},"channelId":{"minLength":1,"type":"string"},"expiresAt":{"format":"date-time","type":"string"},"hopCount":{"minimum":0,"type":"integer"},"idempotencyKey":{"minLength":1,"type":"string"},"issuedAt":{"format":"date-time","type":"string"},"kind":{"enum":["discussion","announcement","emergency","control"],"type":"string"},"messageId":{"minLength":1,"type":"string"},"recipientIds":{"items":{"minLength":1,"type":"string"},"type":"array"},"senderId":{"minLength":1,"type":"string"},"tenantId":{"minLength":1,"type":"string"},"threadTs":{"type":["string","null"]},"turnNumber":{"minimum":1,"type":["integer","null"]}},"required":["messageId","idempotencyKey","tenantId","channelId","threadTs","senderId","recipientIds","kind","hopCount","turnNumber","issuedAt","expiresAt","bodyRef","bodySha256"],"title":"MessageEnvelope","type":"object"}